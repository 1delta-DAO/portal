# Copy to .env and fill in. All variables are optional except where noted —
# but without VITE_WC_PROJECT_ID, mobile (WalletConnect) wallets silently fail.

# Backend API base URL. Defaults to the public 1delta backend. For a fork,
# point this at your server-side proxy (see "Backend API" in README.md).
# VITE_BACKEND_BASE_URL=https://portal.1delta.io

# WalletConnect / Reown project id — get one at https://cloud.reown.com.
# Required for mobile wallet connections; desktop injected wallets work without it.
VITE_WC_PROJECT_ID=

# ── Feature flags (see src/config/flags.ts) ──────────────────────────────────

# Show the Optimize tab (default off).
# VITE_OPTIMIZER_ENABLED=true

# Hide the Cross-Chain (bridge) tab, which ships enabled with a "Beta" pill.
# VITE_BRIDGE_UI_ENABLED=false


# Fetch user positions via client-side RPC instead of the API (default off).
# VITE_USER_POSITIONS_RPC=true
